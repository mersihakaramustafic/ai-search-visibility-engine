# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Supabase connection string (Supabase dashboard -> Connect -> Session pooler, URI format).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Optional: a separate database for tests (alembic -x db_env=TEST_DATABASE_URL upgrade head)
# TEST_DATABASE_URL=

# API keys for scripts/collect_responses.py. The variable names are set per
# provider in configs/collection.yaml (api_key_env).
OPENAI_API_KEY=<openai-api-key>
GEMINI_API_KEY=<gemini-api-key>
